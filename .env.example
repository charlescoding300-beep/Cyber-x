# Copy these names into the private .env file; never commit real API keys.
# Gemini keys power Character AI writing; provider usage limits still apply.
GEMINI_API_KEYS=

# ElevenLabs keys power the optional Character AI voice replies.
# Use one key per line with numbered variables, or a comma-separated list.
ELEVENLABS_API_KEYS=
# ELEVENLABS_API_KEY_1=
# ELEVENLABS_API_KEY_2=

# Eleven v4 supports emotional cues such as [laughs] and [whispers].
ELEVENLABS_MODEL=eleven_v4
# Optional stock voice overrides; defaults are Sarah (female) and Adam (male).
# CHARAI_FEMALE_VOICE_ID=EXAVITQu4vr4xnSDxMaL
# CHARAI_MALE_VOICE_ID=pNInz6obpgDQGcFmaJgB

# 60% voice notes and 40% text replies when ElevenLabs is configured.
CHARAI_VOICE_CHANCE=0.6
# Defaults to the built-in female Sarah voice; override with a voice ID if desired.
# CHARAI_VOICE_ID=EXAVITQu4vr4xnSDxMaL
